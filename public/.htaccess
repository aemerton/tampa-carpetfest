# Apache settings for tampacarpetfest.com (DreamHost).

Options -MultiViews
RewriteEngine On

# Always use HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Use the bare domain (www.tampacarpetfest.com → tampacarpetfest.com) so
# logins aren't split between two addresses.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# The app handles its own pages (e.g. /attendees/123): any address that
# isn't a real file gets index.html, so refreshing or sharing a link works.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Always check for a new version of the page itself, so updates show up
  # right after a deploy...
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # ...while the build files (their names change every build) can be cached.
  <If "%{REQUEST_URI} =~ m#^/_expo/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
